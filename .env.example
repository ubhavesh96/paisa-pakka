# Add at least ONE key. The app uses the first that works, in this order:
# Claude (paid) -> Gemini (free tier) -> Groq (free tier) -> OpenRouter

# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free backup: https://console.groq.com/keys
GROQ_API_KEY=
# Optional paid, best quality: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# AI_PROVIDER=gemini
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# GROQ_MODELS=openai/gpt-oss-120b
# PP_DISABLE_WEB_SEARCH=1
